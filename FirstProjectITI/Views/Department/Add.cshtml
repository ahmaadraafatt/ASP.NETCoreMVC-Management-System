@model Department

@{
	ViewData["Title"] = "Add";
}
<h1>Add</h1>
<form method="post" action="/Department/SaveAdd">
<div>
	<label>Name</label>
		<input name="Name" id="Name"  value="@Model?.Name"  type="text" class=" form-control">
	</div>	

	<div>
		<label>ManagerName</label>
		<input name="ManagerName" id="ManagerName"  value="@Model?.ManagerName" type="text" class=" form-control">
	</div>
	<input type="submit" value="Creat" class="btn btn-primary "/> 
	<a href="/Department/Index">Back To List</a>
 </form>