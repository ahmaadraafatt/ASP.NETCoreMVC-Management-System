@model List<Student>

<a href="/Student/New" class="btn btn-primary mb-3">Add New Student</a>

<table class="table table-bordered table-hover">
	@foreach (var item in Model)
	{
		<tr>
			<td>@item.Id</td>
			<td>@item.Name</td>
			<td>
				<img src="~/Images/@item.Image" style="width:80px" />
			</td>
			<td>
				<a href="/Student/Edit/@item.Id" class="btn btn-primary">Edit</a>
			</td>
			<td>
				<form method="post" action="/Student/Delete/@item.Id">
					<button type="submit" class="btn btn-danger">Delete</button>
				</form>
			</td>
		</tr>
	}
</table>