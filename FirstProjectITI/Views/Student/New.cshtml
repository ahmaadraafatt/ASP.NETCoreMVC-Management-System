@model Student
@{
    ViewData["Title"] = "New";
}
<h1>Add New Student</h1>

<form method="post" action="/Student/New">
    <div>
        <label>Name</label>
        <input type="text" name="Name" class="form-control" />
        <span class="text-danger">@Html.ValidationMessage("Name")</span>
    </div>
    <div>
        <label>Address</label>
        <input type="text" name="Address" class="form-control" />
        <span class="text-danger">@Html.ValidationMessage("Address")</span>
    </div>
    <div>
        <label>Age</label>
        <input type="number" name="Age" class="form-control" />
        <span class="text-danger">@Html.ValidationMessage("Age")</span> 
    </div>
    <div>
        <label>Image</label>
        <input type="text" name="Image" class="form-control" />
        <span class="text-danger">@Html.ValidationMessage("Image")</span>
    </div>
    <div>
<label>Department</label>       
         <input type="number" name="Dept_id" class="form-control" /> 
         <span class="text-danger">@Html.ValidationMessage("Dept_id")</span> 
    </div>
    <input type="submit" value="Save" class="btn btn-success" />
</form>
