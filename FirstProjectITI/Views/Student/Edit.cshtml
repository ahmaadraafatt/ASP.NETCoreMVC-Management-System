@model Student

<h1>Edit Student</h1>

<form method="post" action="/Student/SaveEdit/@Model.Id">
	<div>
		<label>Name</label>
		<input type="text" value="@Model.Name" name="Name" class="form-control" />
		<span class="text-danger">@Html.ValidationMessage("Name")</span>
	</div>
	<div>
		<label>Address</label>
		<input type="text" value="@Model.Address" name="Address" class="form-control" />
		<span class="text-danger">@Html.ValidationMessage("Address")</span>
	</div>
	<div>
		<label>Age</label>
		<input type="number" value="@Model.Age" name="Age" class="form-control" />
		<span class="text-danger">@Html.ValidationMessage("Age")</span>
	</div>
	<div>
		<label>Image</label>
		<input type="text" value="@Model.Image" name="Image" class="form-control" />
		<span class="text-danger">@Html.ValidationMessage("Image")</span>
	</div>
	<div>
		<label>Department</label>
		<input type="number" value="@Model.Dept_id" name="Dept_id" class="form-control" />
		<span class="text-danger">@Html.ValidationMessage("Department")</span>
	</div>
	<input type="submit" value="Save" class="btn btn-success" />
	<div asp-validation-summary="All" class="text-danger"></div>
</form>